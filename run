#!/usr/bin/env python3
"""Run ltt's tests.

  ./run                 everything: the unit tests, the functional tests in parallel,
                        then the timing tests alone
  ./run unit [-v]       the unit tests alone (-v lists every check)
  ./run [pytest args]   pytest with these arguments (in parallel unless -n is given),
                        e.g. ./run cases/test_save.py -k crlf, ./run -m perf -n0

The ltt checkout under test is the worktree on `main` of this repository by
default, or --ltt-src=PATH (also LTT_SRC=PATH). The unit tests (unit/, C#)
are compiled together with its sources. For the functional tests each run
builds it into .build/ first (--ltt-dll=PATH tests a built ltt.dll as it
is); the first run creates .venv with the pinned packages.
"""
import hashlib
import importlib.util
import os
import subprocess
import sys
import venv

HERE = os.path.dirname(os.path.abspath(__file__))
VENV = os.path.join(HERE, ".venv")
REQ = os.path.join(HERE, "requirements.txt")
UNIT = os.path.join(HERE, "unit")


def ensure_venv():
    py = os.path.join(VENV, "bin", "python")
    stamp = os.path.join(VENV, ".requirements")
    with open(REQ, "rb") as f:
        want = hashlib.sha256(f.read()).hexdigest()
    if not os.path.exists(py):
        print("ltt tests: creating .venv", file=sys.stderr)
        venv.create(VENV, with_pip=True)
    try:
        with open(stamp) as f:
            have = f.read()
    except FileNotFoundError:
        have = ""
    if have != want:
        subprocess.run([py, "-m", "pip", "install", "-q", "--disable-pip-version-check", "-r", REQ], check=True)
        with open(stamp, "w") as f:
            f.write(want)
    return py


def pytest(py, args):
    return subprocess.run([py, "-m", "pytest", *args], cwd=HERE).returncode


def unit(args):
    """Build the unit tests together with the checkout's sources and run them."""
    spec = importlib.util.spec_from_file_location("build", os.path.join(HERE, "harness", "build.py"))
    build = importlib.util.module_from_spec(spec)  # this file alone: the harness package needs the venv
    spec.loader.exec_module(build)
    try:
        src = build.find_source()
    except RuntimeError as e:
        print(f"ltt tests: {e}", file=sys.stderr)
        return 2
    print(f"ltt tests: unit tests of {src}", file=sys.stderr)
    env = dict(os.environ, LTT_SRC=src, DOTNET_NOLOGO="1", DOTNET_CLI_TELEMETRY_OPTOUT="1")
    r = subprocess.run(["dotnet", "build", UNIT, "-nologo", "-v", "q", "-clp:NoSummary"],
                       env=env, capture_output=True, text=True)
    if r.returncode != 0:
        print(f"building the unit tests failed:\n{r.stdout}\n{r.stderr}", file=sys.stderr)
        return r.returncode
    return subprocess.run(["dotnet", os.path.join(UNIT, "bin", "Debug", "net10.0", "unit.dll"), *args],
                          env=env).returncode


def main():
    args = sys.argv[1:]
    if args[:1] == ["unit"]:
        return unit(args[1:])
    py = ensure_venv()
    if args:
        if not any(a == "-n" or a.startswith("-n") or a.startswith("--numprocesses") for a in args):
            args = ["-n", "auto", *args]
        return pytest(py, args)
    unit_tests = unit([])
    functional = pytest(py, ["-n", "auto", "-m", "not perf"])
    timing = pytest(py, ["-p", "no:xdist", "-m", "perf"])
    return unit_tests or functional or (0 if timing == 5 else timing)  # 5: no timing tests collected


if __name__ == "__main__":
    sys.exit(main())
