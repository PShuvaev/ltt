<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ltt</AssemblyName>
    <!-- No apphost: run via `dotnet run` / `dotnet bin/.../ltt.dll` -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <!-- .NET takes a shared flock on every file it opens: a file another program holds under an
         exclusive one (vis, a script) could not be read. ltt locks nothing, as other editors. -->
    <RuntimeHostConfigurationOption Include="System.IO.DisableFileLocking" Value="true" />
  </ItemGroup>

</Project>
